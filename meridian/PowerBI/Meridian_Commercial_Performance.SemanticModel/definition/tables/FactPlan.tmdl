table FactPlan

	/// PeriodStart source field
	column PeriodStart
		dataType: dateTime
		summarizeBy: none
		sourceColumn: PeriodStart

	/// Channel source field
	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: Channel

	/// Market source field
	column Market
		dataType: string
		summarizeBy: none
		sourceColumn: Market

	/// Category source field
	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	/// PlanVersion source field
	column PlanVersion
		dataType: string
		summarizeBy: none
		sourceColumn: PlanVersion

	/// RevenueUSD source field
	column RevenueUSD
		dataType: double
		summarizeBy: none
		sourceColumn: RevenueUSD

	/// GrossProfitUSD source field
	column GrossProfitUSD
		dataType: double
		summarizeBy: none
		sourceColumn: GrossProfitUSD

	partition FactPlan = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(pDataRoot & "\FactPlan.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"PeriodStart", type date}, {"Channel", type text}, {"Market", type text}, {"Category", type text}, {"PlanVersion", type text}, {"RevenueUSD", type number}, {"GrossProfitUSD", type number}}, "en-US")
			in
			    Typed
