table DimComparison

	/// Comparison source field
	column Comparison
		dataType: string
		summarizeBy: none
		sourceColumn: Comparison

	partition DimComparison = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(pDataRoot & "\DimComparison.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"Comparison", type text}}, "en-US")
			in
			    Typed
