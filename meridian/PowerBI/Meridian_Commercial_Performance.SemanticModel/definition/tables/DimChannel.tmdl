table DimChannel

	/// Channel source field
	column Channel
		dataType: string
		summarizeBy: none
		sourceColumn: Channel

	partition DimChannel = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(pDataRoot & "\DimChannel.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"Channel", type text}}, "en-US")
			in
			    Typed
