table DimMarket

	/// Market source field
	column Market
		dataType: string
		summarizeBy: none
		sourceColumn: Market

	partition DimMarket = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(pDataRoot & "\DimMarket.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Headers, {{"Market", type text}}, "en-US")
			in
			    Typed
